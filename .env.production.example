# Cấu hình cho NICK CHÍNH, chỉ dùng sau khi đã chạy yên trên nick phụ.
# Chép thành .env trên máy nhà (không chạy trên VPS: IP lạ dễ bị Zalo soi).

# Nick chính / nick phụ thêm và đổi trên dashboard; dữ liệu mỗi nick nằm riêng ở data/accounts/<nick>/
DATA_DIR=./data
ARCHIVE_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=info

# KHÔNG cần đặt: khóa mã hóa cookie tự sinh ở data/app-secrets.json lần chạy đầu.
# Chỉ máy đã chạy bản cũ (khóa nằm ở .env) mới giữ dòng này để app lấy đúng khóa cũ một lần.
CREDENTIALS_ENCRYPTION_KEY=

# Nối lại thận trọng hơn: nick chính bị đá lặp là dấu hiệu xấu
RECONNECT_BASE_DELAY_SECONDS=10
RECONNECT_MAX_DELAY_SECONDS=600
RECONNECT_DUPLICATE_WAIT_MINUTES=30
# Lần mã 3000 đầu tiên (thường lúc vừa mở máy) thử lại sau bấy nhiêu giây; bị lại mới chờ số phút ở trên
RECONNECT_DUPLICATE_FIRST_RETRY_SECONDS=60
RECONNECT_GIVE_UP_AFTER_FLAPS=6

# Nick chính: đăng nhập thưa hơn
ZALO_LOGIN_COOLDOWN_SECONDS=60
OFFLINE_REPLAY_ENABLED=true
OFFLINE_REPLAY_MIN_INTERVAL_MINUTES=15
# Chỉ bật những gì đã đo trên nick phụ
ZALO_KEEPALIVE_MINUTES=0
DIRECTORY_SYNC_HOURS=12
# Nick chính: hỏi hồ sơ thưa (giây giữa hai lượt), bị Zalo chặn thì nghỉ (phút, gấp đôi mỗi lần)
DIRECTORY_CONTACT_LOOKUP_GAP_SECONDS=60
DIRECTORY_RATE_LIMIT_PAUSE_MINUTES=30

MEDIA_DOWNLOAD_ENABLED=true
# Trần cỡ mỗi file (MB). Zalo cho gửi file tới 1 GB
MEDIA_MAX_MEGABYTES=1024
MEDIA_MAX_ATTEMPTS=5
MEDIA_DOWNLOAD_TIMEOUT_MINUTES=15
MEDIA_ALLOWED_HOST_SUFFIXES=zdn.vn,zadn.vn,zalo.me,zaloapp.com,zalo.vn,dlfl.vn,flchat.vn,dlmd.me,mdchat.me
# Xin lại link media hết hạn: nhịp ngẫu nhiên MIN..MAX giây giữa hai lệnh, trần lệnh mỗi ngày
MEDIA_RENEW_ENABLED=true
MEDIA_RENEW_MIN_GAP_SECONDS=4
MEDIA_RENEW_MAX_GAP_SECONDS=10
MEDIA_RENEW_DAILY_CAP=200
# File tin cũ hơn số ngày này mà Zalo đã xóa thì không gọi máy chủ (máy chủ không còn trả file quá ~30 ngày).
# Giảm thì đồng bộ lịch sử dài dọn hàng đợi nhanh hơn nhưng có thể bỏ sót file còn tải được; 0 = luôn thử tải
MEDIA_ASSUME_DELETED_AFTER_DAYS=40
# Lấy lại ảnh / video Zalo đã xóa khỏi máy chủ từ bản Zalo PC đã tải về máy này (CHỈ ĐỌC, không sửa gì
# của Zalo PC). Bỏ trống = %LOCALAPPDATA%\ZaloPC (mặc định của Zalo PC trên Windows).
# ZALO_PC_DATA_DIR=

# --- Gửi tin. Đây là MẶC ĐỊNH; sửa trên dashboard (Cài đặt) thì phần sửa lưu trong DB và đè lên ---
# Tin lẻ (anh bảo gửi cho một người): hai tin bất kỳ cách nhau tối thiểu bấy nhiêu giây
SEND_SINGLE_MIN_GAP_SECONDS=3
# Gửi nhiều người một lúc (lô): từng tin, cách nhau ngẫu nhiên trong khoảng này (giây), chỉ tới bạn bè
SEND_BATCH_MIN_GAP_SECONDS=45
SEND_BATCH_MAX_GAP_SECONDS=180
# Lô chỉ gửi trong khung giờ [bắt đầu, kết thúc) theo ARCHIVE_TIMEZONE; tin lẻ không bị giới hạn giờ
SEND_BATCH_WINDOW_START_HOUR=7
SEND_BATCH_WINDOW_END_HOUR=22
# Tối đa số tin của lô mỗi ngày (tin lẻ không tính)
SEND_BATCH_DAILY_CAP=50
# Một lô tối đa bao nhiêu người
SEND_BATCH_MAX_ITEMS=30
# Tin hẹn giờ / đã duyệt mà trễ quá bấy nhiêu giờ (bị khóa lâu, daemon tắt...) thì bỏ, không gửi muộn
SEND_MAX_LATENESS_HOURS=12

# --- Dashboard web (chạy cùng daemon: pnpm start) ---
# Chỉ nghe trên máy này. Đừng đổi sang 0.0.0.0 nếu không có reverse proxy + HTTPS phía trước.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3210
# Nhịp dò tin mới cho dashboard tự cập nhật (ms); chỉ chạy khi có tab dashboard đang mở
DASHBOARD_LIVE_CHECK_MS=1000
# Mật khẩu dashboard: KHÔNG đặt ở đây - tạo trên dashboard lần đầu mở. Quên thì: pnpm reset-password
