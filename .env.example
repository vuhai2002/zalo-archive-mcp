# Cấu hình cho lần chạy thử trên NICK PHỤ. Chép thành .env rồi điền khóa.
# Dòng để trống giá trị (KEY=) thì dùng mặc định trong src/config/env-schema.ts.

# Tên thư mục account trong data/accounts/ (chữ thường, số, gạch ngang)
ZALO_ACCOUNT_ID=nick-phu

# Thư mục dữ liệu (tin nhắn, media, DB, cookie mã hóa). Tương đối với gốc project.
DATA_DIR=./data

# Múi giờ để hiển thị giờ tin, tính "hôm nay" cho trần gửi và khung giờ gửi
ARCHIVE_TIMEZONE=Asia/Ho_Chi_Minh

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Khóa AES-256 mã hóa cookie Zalo trên đĩa (64 ký tự hex). Chỉ lệnh login và daemon cần.
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# --- Nối lại listener khi rớt mạng ---
# Chờ ban đầu, tăng gấp đôi mỗi lần rớt liên tiếp, tới trần
RECONNECT_BASE_DELAY_SECONDS=5
RECONNECT_MAX_DELAY_SECONDS=300
# Bị đá vì có phiên Zalo Web khác (mã 3000): chờ lâu rồi mới nối lại, tránh giằng co
RECONNECT_DUPLICATE_WAIT_MINUTES=15
# Nối rồi rớt ngay liên tiếp bấy nhiêu lần thì dừng hẳn, báo cần đăng nhập lại
RECONNECT_GIVE_UP_AFTER_FLAPS=8

# --- Phần chờ số đo thật, mặc định tắt ---
# Sau mỗi lần nối lại, xin Zalo gửi lại tin lỡ (cmd 510/511, mới lấy trang đầu)
OFFLINE_REPLAY_ENABLED=false
# Gọi keepAlive định kỳ (phút), 0 = tắt
ZALO_KEEPALIVE_MINUTES=0
# Đồng bộ danh sách bạn bè + tên nhóm (giờ), 0 = chỉ lúc khởi động
DIRECTORY_SYNC_HOURS=12

# --- Tải ảnh/file/video/voice về máy ngay khi tin tới ---
MEDIA_DOWNLOAD_ENABLED=true
MEDIA_MAX_MEGABYTES=200
MEDIA_MAX_ATTEMPTS=5
# Thời gian tối đa tải một file (phút), tính cả phần thân file
MEDIA_DOWNLOAD_TIMEOUT_MINUTES=15
# Chỉ tải từ các host CDN của Zalo (đuôi tên miền, cách nhau dấu phẩy). File gửi kèm nằm ở
# dlfl.vn và chuyển tiếp sang flchat.vn, ảnh/sticker/avatar ở zdn.vn / zadn.vn.
MEDIA_ALLOWED_HOST_SUFFIXES=zdn.vn,zadn.vn,zalo.me,zaloapp.com,zalo.vn,dlfl.vn,flchat.vn

# --- Gửi tin. Đây là MẶC ĐỊNH; sửa trên dashboard (Cài đặt) thì phần sửa lưu trong DB và đè lên ---
# Tin lẻ (anh bảo gửi cho một người): hai tin bất kỳ cách nhau tối thiểu bấy nhiêu giây
SEND_SINGLE_MIN_GAP_SECONDS=3
# Gửi nhiều người một lúc (lô): từng tin, cách nhau ngẫu nhiên trong khoảng này (giây), chỉ tới bạn bè
SEND_BATCH_MIN_GAP_SECONDS=45
SEND_BATCH_MAX_GAP_SECONDS=180
# Lô chỉ gửi trong khung giờ [bắt đầu, kết thúc) theo ARCHIVE_TIMEZONE; tin lẻ không bị giới hạn giờ
SEND_BATCH_WINDOW_START_HOUR=7
SEND_BATCH_WINDOW_END_HOUR=22
# Tối đa số tin của lô mỗi ngày (tin lẻ không tính)
SEND_BATCH_DAILY_CAP=100
# Một lô tối đa bao nhiêu người
SEND_BATCH_MAX_ITEMS=50
# Tin hẹn giờ / đã duyệt mà trễ quá bấy nhiêu giờ (bị khóa lâu, daemon tắt...) thì bỏ, không gửi muộn
SEND_MAX_LATENESS_HOURS=12

# --- Dashboard web (chạy cùng daemon: pnpm start) ---
# Chỉ nghe trên máy này. Đừng đổi sang 0.0.0.0 nếu không có reverse proxy + HTTPS phía trước.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3210
# Mật khẩu vào dashboard (tối thiểu 8 ký tự). Để trống thì dashboard không mở.
DASHBOARD_PASSWORD=
